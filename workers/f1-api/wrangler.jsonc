{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "f1-api",
  "main": "src/index.js",
  "compatibility_date": "2026-09-30",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "f1-api.propbetedge.ai", "custom_domain": true }],
  "observability": { "enabled": true },
  "limits": { "cpu_ms": 60000 },
  "triggers": { "crons": ["*/10 * * * *"] },
  "r2_buckets": [{ "binding": "DATA", "bucket_name": "f1-data" }],
  // network membership authority (All Access): same binding every All-Access-only sport uses
  "services": [{ "binding": "AUTH", "service": "propbetedge-auth-magic" }],
  "durable_objects": { "bindings": [{ "name": "LIVE", "class_name": "LiveHub" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["LiveHub"] }]
}
